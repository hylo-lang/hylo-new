// A missing yield.
subscript f0(x: Bool) -> Bool {
  if x { yield true }
  if x { yield false }
}

// Two consecutive yields in the same basic block.
subscript f1(x: Bool) -> Bool {
  yield true
  yield false
}

// Two consecutive yields in different basic blocks.
subscript f2(x: Bool) -> Bool {
  if x { yield true }
  yield false
}

// Two consecutive yields in different basic blocks.
subscript f3(x: Bool) -> Bool {
  yield false
  if x { yield true }
}

// A yield in a loop.
subscript f4(x: Bool) -> Bool {
  while x { yield true }
  yield false
}

// A yield before a loop is fine.
subscript g0(x: Bool) -> Bool {
  yield true
  while x {}
}

// A yield after a loop is fine.
subscript g1(x: Bool) -> Bool {
  while x {}
  yield true
}
