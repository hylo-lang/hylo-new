extension Int {

  public fun infix&>> (other: Int) -> Self {
    .new(value: Builtin.lshr_word(self.value, other.value))
  }

  @inline
  public fun infix^ (other: Self) -> Self {
    .new(value: Builtin.xor_word(self.value, other.value))
  }

  @inline
  public fun prefix~ () -> Self {
    self ^ -1
  }

}

extension Pointer<String.Buffer> {

  /// Creates an instance with the same memory representation as `address`.
  @inline
  init(bit_pattern address: Int) {
    &self.value = Builtin.inttoptr_word(address.value)
  }

}

extension String {

  /// The out-of-line buffer of a string.
  struct Buffer {

    /// The number of elements in the buffer.
    var count: Int

    /// The capacity of the buffer.
    var capacity: Int

  }

  /// Returns `true` if the payload of `self` is stored inline.
  fun is_inline() -> Bool {
    (self.units & 0b10) == 0
  }

  /// Returns `true` if `self` does not own its payload.
  fun is_unowned() -> Bool {
    (self.units & 0b01) != 0
  }

  /// Returns the number of elements in `self`.
  fun count() -> Int {
    if self.is_inline() {
      return (self.units & 0xff) &>> 2
    } else {
      let p = Pointer<String.Buffer>(bit_pattern: self.units & ~0b11)
      let b = p.value as* let String.Buffer
      return b.count + 0
    }
  }

}

public fun main() {
  let short = "abc"
  precondition(short.is_inline())
  precondition(short.count() == 3)

  let large = "abcdefghijklmnop"
  precondition(large.count() == 16)
}
