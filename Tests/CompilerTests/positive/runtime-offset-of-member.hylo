/// Make it so the pointees start..<end contain only the elements with
/// alignments greater than that of n, or with the same alignment as n
/// but occurring at a position < n.
fun retain_only_elements(
  from start: inout Pointer<RecordMemberType>,
  to end: inout Pointer<RecordMemberType>,
  that_lay_out_before n: Pointer<RecordMemberType>
) {
  let n_alignment = n.pointee().alignment()

  // Drop initial unretained elements before n
  while start < n && start.pointee().alignment() < n_alignment {
    start += 1
  }

  print_space(); print(from: start, to: end)

  if start < n {
    // start..<n..<end begins with a retained element

    // Find first unretained; n is always unretained so we can stop
    // there.
    var i = start + 1
    while i < n && i.pointee().alignment() >= n_alignment {
      i += 1
    }

    // The position of the first unretained element, or end if all are
    // retained.
    var hole = i.copy()

    // Next candidate for moving into the hole.
    var j = hole + 1

      // Copy remaining retained elements backward into the unretained
      // space we found.
    while j < n {
      /* Workaround https://github.com/hylo-lang/hylo-new/issues/370
      let w = j.pointee()
      if w.alignment() >= n_alignment {
        hole.set_pointee(w)
        hole += 1
      }
       */
      if j.pointee().alignment() >= n_alignment {
        hole.set_pointee(j.pointee())
        hole += 1
      }
      j += 1
    }

    // skip over n, it's always unretained.
    if j == n { j += 1 }

    while j != end {
      /* Workaround https://github.com/hylo-lang/hylo-new/issues/370
      let w = j.pointee()
      if w.alignment() > n_alignment {
        hole.set_pointee(w)
        hole += 1
      }
       */
      if j.pointee().alignment() > n_alignment {
        hole.set_pointee(j.pointee())
        hole += 1
      }
      j += 1
    }
    // Workaround https://github.com/hylo-lang/hylo-new/issues/381
    &end.value = hole.value

  } else {  // None retained before n?
    // Drop n, which is always unretained
    &start = n + 1

    // Drop remaining initial unretained elements
    while start < end && start.pointee().alignment() <= n_alignment {
      start += 1
    }

    print_space(); print(from: start, to: end)

    // No elements remain to retain.
    if start == end { return }

    // start..<end begins with a retained element; start > n

    // Find first unretained
    var i = start + 1
    while i != end && i.pointee().alignment() > n_alignment {
      i += 1
    }
    if i == end { return }  // all the rest are retained.

    print_space(); print_space(); print(from: i, to: end)

    // The position of the first unretained element, or end if all are
    // retained.
    var hole = i.copy()

    // Copy remaining retained elements backward into the unretained
    // space we found.
    var j = hole + 1
    // precondition(j > n)
    while j != end {
      /* Workaround https://github.com/hylo-lang/hylo-new/issues/370
       let w = j.pointee()
       if w.alignment() > n_alignment {
         hole.set_pointee(w)
         hole += 1
       }
         */
      if j.pointee().alignment() > n_alignment {
        hole.set_pointee(j.pointee())
        hole += 1
      }
      j += 1

      print_space(); print_space(); print_space(); print(from: start, to: hole)
    }
    print_comma_space(); print(from: start, to: hole)
    // Workaround https://github.com/hylo-lang/hylo-new/issues/381
    &end.value = hole.value
    print_comma_space(); print(from: start, to: end)
  }
}

/// Stably sorts the elements in decreasing alignment order.
///
/// - Precondition: start != end
///
/// - Complexity: *O*(`end-start`²) (insertion sort)
fun stable_sort_by_decreasing_alignment(
  from start: Pointer<RecordMemberType>,
  to end: Pointer<RecordMemberType>
) {
  var prior_alignment = start.pointee().alignment()
  var i = start + 1

  while i < end {
    // invariant: elements start..<w are sorted.

    sink let w = i.pointee()
    sink let w_alignment = w.alignment()

    if prior_alignment >= w_alignment {
      // w was already in the right place
      &prior_alignment = w_alignment
    } else {

      // Since we copied from i into w, we can consider i a hole
      var hole = i.copy()
      // Shuffle the hole towared the front until it's in the right
      // place.
      var prior_to_hole = hole - 1
      var done = false
      while !done {
        hole.set_pointee(prior_to_hole.pointee())
        &hole = prior_to_hole.copy()
        if hole == start {
          &done = true
        }
        else {
          &hole = prior_to_hole.copy()
          &prior_to_hole = hole - 1
          if prior_to_hole.pointee().alignment() >= w_alignment {
            &done = true
          }
        }
      }
      // put w in the hole.
      hole.set_pointee(w)
    }

    i += 1
  }
}

fun size_of_record_having_ordered_members(
  from start_: Pointer<RecordMemberType>,
  to end: Pointer<RecordMemberType>
) -> Size {
  var r: Size = 0
  var start = start_.copy()
  while start < end {
    let w = start.pointee()
    let position = w.alignment().first_aligned_offset(starting_from: r)
    &r = position + w.size()
    start += 1
  }
  return r
}

/// Returns the offset of the `n`th member in declaration order of a
/// record type having members given by the array of length `l` at
/// `memberArray`.
///
/// Mutates the elements in the array in arbitrary ways.
fun __hylo_offset_of_member(
  n: UInt32,
  in memberArray: Pointer<RecordMemberType>, of_length l: UInt32) -> UInt32
{
  sink let p = memberArray + Int(n)
  sink let nth_alignment = p.pointee().alignment()
  var start = memberArray.copy()
  var end = memberArray + Int(l)

  print(from: start, to: end)
  retain_only_elements(from: &start, to: &end, that_lay_out_before: p)
  print(from: start, to: end)
  if start == end { return 0 }
  stable_sort_by_decreasing_alignment(from: start, to: end)
  print(from: start, to: end)
  let preceding_size = size_of_record_having_ordered_members(from: start, to: end)
  print_space(); print(preceding_size); print_space(); print(nth_alignment)
  sink let r = nth_alignment.first_aligned_offset(starting_from: preceding_size)
  print(r); print_newline();
  return r
}

@extern_c_indirect("print_intptr_indirect") fun print_ptr(x: Builtin.ptr)
@extern_c_indirect("print_long_indirect") fun print(x: Int)
@extern_c_indirect("print_u32_indirect") fun print(x: UInt32)
@extern_c_indirect("print_u16_indirect") fun print(x: UInt16)
@extern_c_indirect("print_newline_indirect") fun print_newline()
@extern_c_indirect("print_space_indirect") fun print_space()
@extern_c_indirect("print_comma_indirect") fun print_comma()
@extern_c_indirect("print_open_paren_indirect") fun print_open_paren()
@extern_c_indirect("print_close_paren_indirect") fun print_close_paren()
@extern_c_indirect("print_size_indirect") fun print_size(x: UInt32)
@extern_c_indirect("print_alignment_indirect") fun print_alignment(x: UInt16)

fun print_comma_space() { print_comma(); print_space() }

fun print(p: RecordMemberType) {
  print_open_paren();
  print(p.size()); print_space(); print(p.alignment());
  print_close_paren()
}

fun print(from start: Pointer<RecordMemberType>, to end: Pointer<RecordMemberType>) {
  var s = start.copy()
  while s != end {
    print(s.pointee()); print_comma_space()
    s += 1
  }
  print_newline()
}

// --------------- TESTING -------------

extension TypeWitnessHeader {

  init(size: Int, alignment: Int) {
    Pointer<UInt8>.null_(&self.description)
    &self.size = .new(truncating: size)
    &self.alignment = .new(truncating: alignment)
    &self.type_argument_or_parameter_count = .zero()
  }

  /// Fatal error unless TypeWitnessHeader lays out in declaration
  /// order in Hylo.
  static fun checkLayoutAssumptions() {
    precondition(
      Metatype<Pointer<UInt8>>.alignment() >= Metatype<Size>.alignment())
    precondition(
      Metatype<Size>.alignment() >= Metatype<Alignment>.alignment())
  }

}

type H = TypeWitnessHeader

subscript pointer(to x: TypeWitnessHeader) -> Pointer<TypeWitnessHeader> {
  yield .new(value: Builtin.address(of: x))
}

fun verify_offset(
  i: Int,
  in headers: H[10],
  of_length l: Int,
  to_be x: Int
) -> Bool {
  let p = Pointer<H>(value: Builtin.address(of: headers))
  var witnesses: Pointer<TypeWitnessHeader>[10] = (
    p + 0, p + 1, p + 2, p + 3, p + 4, p + 5, p + 6, p + 7, p + 8, p + 9)

  let o = __hylo_offset_of_member(
    .new(truncating: i),
    in: .new(value: Builtin.address(of: witnesses)),
    of_length: .new(truncating: l))

  print_comma();print_comma();print_comma(); print(i); print_comma(); print(o); print_space(); print(x); print_newline()
  return o == UInt32(truncating: x)
}

fun verify_offsets(
    forFirst n: Int,
    in s0: Int, a0: Int, s1: Int, a1: Int, s2: Int, a2: Int, s3: Int, a3: Int, s4: Int, a4: Int, s5: Int, a5: Int, s6: Int, a6: Int, s7: Int, a7: Int, s8: Int, a8: Int, s9: Int, a9: Int,
    to_be o0: Int, o1: Int, o2: Int, o3: Int, o4: Int, o5: Int, o6: Int, o7: Int, o8: Int, o9: Int) {
  let h0 = H(s0, a0)
  let h1 = H(s1, a1)
  let h2 = H(s2, a2)
  let h3 = H(s3, a3)
  let h4 = H(s4, a4)
  let h5 = H(s5, a5)
  let h6 = H(s6, a6)
  let h7 = H(s7, a7)
  let h8 = H(s8, a8)
  let h9 = H(s9, a9)

  var b = true
  if n > 0 {
    &b = verify_offset(0, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o0) && b
  }
  if n > 1 {
    &b = verify_offset(1, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o1) && b
  }
  if n > 2 {
    &b = verify_offset(2, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o2) && b
  }
  if n > 3 {
    &b = verify_offset(3, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o3) && b
  }
  if n > 4 {
    &b = verify_offset(4, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o4) && b
  }
  if n > 5 {
    &b = verify_offset(5, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o5) && b
  }
  if n > 6 {
    &b = verify_offset(6, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o6) && b
  }
  if n > 7 {
    &b = verify_offset(7, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o7) && b
  }
  if n > 8 {
    &b = verify_offset(8, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o8) && b
  }
  if n > 9 {
    &b = verify_offset(9, in: (H(s0, a0), H(s1, a1), H(s2, a2), H(s3, a3), H(s4, a4), H(s5, a5), H(s6, a6), H(s7, a7), H(s8, a8), H(s9, a9)), of_length: n, to_be: o9) && b
  }
  precondition(b)
}

fun main() {
  TypeWitnessHeader.checkLayoutAssumptions()
