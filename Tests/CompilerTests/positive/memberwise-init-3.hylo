//! exit-status:15

// This test exercises the lowering of calls to generic memberwise initializers.

struct Result is Movable & Deinitializable {
  var status: Int32
  memberwise init
  fun take_value(from other: sink Result) auto {
    set   { &self.status = other.status }
    inout { &self.status = other.status }
  }
}

struct Wrap<T> {
  var value: T
  memberwise init
}

given <T is Deinitializable> => Wrap<T> is Deinitializable {
  fun deinit() sink { _ = self.value }
}

public fun main() -> Int32 {
  // Reference to memberwise initializer is a synthetic expression elaborated during typing.
  sink let w0 = Wrap(value: Result(status: 0b0101 as Int32))
  // Reference to memberwise initializer is a static call.
  sink let w1 = Wrap<Result>(value: .new(status: 0b1010 as Int32))

  sink let x = w0.value.status | w1.value.status
  w0.deinit()
  w1.deinit()
  return x
}
