// Exercises the arithmetic and comparison operators of `Float32` and `Float64`.
//
// All values are exactly representable in binary floating-point so that the comparisons are exact.

fun test_f32() {
  var x: Float32 = 1.5
  &x += 2.0 as Float32  // 3.5
  &x *= 4.0 as Float32  // 14.0
  &x -= 2.0 as Float32  // 12.0
  let y = (x + (0.5 as Float32)) * (2.0 as Float32) - (1.0 as Float32) // 24.0

  precondition(x == (12.0 as Float32))
  precondition(y == (24.0 as Float32))
  precondition(x != y)
  precondition(x <= (12.0 as Float32))
  precondition(x <= y)
  precondition(y >= (24.0 as Float32))
  precondition(y >= x)
  precondition(x < y)
  precondition(y > x)
  precondition(!(y < x))
  precondition(!(x > y))

  // `zero()` is the additive identity.
  precondition(Float32.zero() == (0.0 as Float32))
  precondition(x + Float32.zero() == x)
  precondition(x - x == Float32.zero())

  // Negative values and mixed-sign arithmetic.
  let n = (0.0 as Float32) - x  // -12.0
  precondition(n < Float32.zero())
  precondition(n + x == Float32.zero())
  precondition(n * (-1.0 as Float32) == x)
  precondition(n <= (-12.0 as Float32))
  precondition(n >= (-12.0 as Float32))
}

fun test_f64() {
  var x: Float64 = 1.5
  &x += 2.0  // 3.5
  &x *= 4.0  // 14.0
  &x -= 2.0  // 12.0
  let y = (x + 0.5) * 2.0 - 1.0 // 24.0

  precondition(x == 12.0)
  precondition(x != y)
  precondition(x <= 12.0)
  precondition(y >= 24.0)
  precondition(x < y)
  precondition(y > x)
  precondition(x - x == Float64.zero())
}

public fun main() {
  test_f32()
  test_f64()
}
