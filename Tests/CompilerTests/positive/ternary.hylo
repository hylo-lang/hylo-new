//! stage:typing

public fun main() {
  // Trivial case case.
  let x = 0
  _ = if true { x } else { x }

  // Expected type flows top-down.
  _ = if true { .zero() } else { Builtin.trap() } as Int
  _ = if true { Builtin.trap() } else { .zero() } as Int

  // Type of one branch flows into the other.
  _ = if true { x } else { Builtin.trap() }
  _ = if true { Builtin.trap() } else { x }
}
