fun expect(c: Builtin.i1) {
  precondition(Bool(value: c))
}

public fun main() {
  expect(Builtin.fcmp_oeq_float64(
    Builtin.frem_float64((5.5 as Float64).value, (2.0 as Float64).value),
    (1.5 as Float64).value))

  // `frem` takes the sign of the dividend.
  expect(Builtin.fcmp_oeq_float64(
    Builtin.frem_float64((-5.5 as Float64).value, (2.0 as Float64).value),
    (-1.5 as Float64).value))
  expect(Builtin.fcmp_oeq_float64(
    Builtin.frem_float64((5.5 as Float64).value, (-2.0 as Float64).value),
    (1.5 as Float64).value))
}
