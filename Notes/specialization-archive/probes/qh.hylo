//! stage:typing no-std
trait Bidi { type Selected }
trait RA refines Bidi {}
struct Slow {}
struct Fast {}
struct MyArray {}
given ra_is_bidi: <T is RA> => T is Bidi { type Selected = Fast }
given MyArray is RA {}
fun client<T is Bidi>(x: T.Selected) -> T.Selected { x }
fun observe(x: MyArray.Selected) -> Fast { x }
