//! stage:typing no-std
trait Bidi { type Selected }
trait RA {}
struct Slow {}
struct Fast {}
struct MyArray {}
given ra_is_bidi: <T is RA> => T is Bidi { type Selected = Fast }
given MyArray is RA {}
given MyArray is Bidi { type Selected = Slow }
fun at_file_scope(x: MyArray.Selected) -> Slow { x }
fun in_a_hot_path() {
  given MyArray is Bidi { type Selected = Fast }
  fun inner(x: MyArray.Selected) -> Fast { x }
}
