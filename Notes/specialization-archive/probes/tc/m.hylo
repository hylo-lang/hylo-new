//! stage:typing no-std
trait Bidi {}
trait RA refines Bidi {}
struct Arr {}
given Arr is Bidi {}
given Arr is RA {}
struct Linear {}
struct Binary {}
trait LowerBound { type Selected }
given <T is Bidi> => T is LowerBound { type Selected = Linear }
given <T is RA>   => T is LowerBound { type Selected = Binary }

fun client<T is LowerBound>(c: T, x: T.Selected) -> T.Selected { x }
fun caller(c: Arr, x: Arr.Selected) -> Binary { client(c, x) }
