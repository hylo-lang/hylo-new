}
trait RA {
  given RA.Self is Bidi
}
trait Marker {
}
struct Arr {
}
given Arr is Bidi {
}
given Arr is Marker {
}
given <T where let $k: Marker<T>, let $q: Bidi<T>> T is RA {
}
struct Linear {
}
struct Binary {
}
trait LowerBound {
  type Selected
}
given <T where let $15: Bidi<T>> T is LowerBound {
  type Selected = Linear
