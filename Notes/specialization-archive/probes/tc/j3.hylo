//! exit-status:2
trait Bidi {}
trait RA refines Bidi {}
struct Arr is Deinitializable & Movable { public memberwise init }
given Arr is Bidi {}
given Arr is RA {}
fun lower_bound<T is Bidi>(x: T) -> Int32 { 1 }
fun lower_bound<T is RA>(x: T) -> Int32 { 2 }
public fun main() -> Int32 { lower_bound(Arr()) }
