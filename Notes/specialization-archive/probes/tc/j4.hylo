//! stage:typing no-std
trait Bidi {}
trait RA refines Bidi {}
struct Arr { public memberwise init }
given Arr is Bidi {}
given Arr is RA {}
struct Linear { public memberwise init }
struct Binary { public memberwise init }
fun lower_bound<T is Bidi>(x: T) -> Linear { Linear() }
fun lower_bound<T is RA>(x: T) -> Binary { Binary() }

// no expected type: only the specificity order can pick one
fun at_concrete_type(a: Arr) { _ = lower_bound(a) }

// only the coarse overload is applicable here, so this return type is a real assertion
fun in_bidi_context<T is Bidi>(x: T) -> Linear { lower_bound(x) }
