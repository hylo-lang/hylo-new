trait Fwd {}
trait Bidi refines Fwd {}
trait RA refines Bidi {}

struct Arr is Deinitializable & Movable { public memberwise init }
given Arr is RA { given Arr is Bidi { given Arr is Fwd {} } }

trait LowerBoundable { fun lb() -> Int32 }
given <T is Bidi> => T is LowerBoundable { fun lb() -> Int32 { 1 } }
given <T is RA>   => T is LowerBoundable { fun lb() -> Int32 { 2 } }

// (A) generic context constrained on the *coarse* trait
fun via_bidi<T is Bidi>(x: T) -> Int32 { x.lb() }

// (B) generic context constrained on the *algorithm* trait
fun via_alg<T is LowerBoundable>(x: T) -> Int32 { x.lb() }

public fun main() -> Int32 { via_bidi(Arr()) + via_alg(Arr()) }
