// Q: can a lifting given override a default implementation inherited via `refines`?
trait Bidi {
  fun lb() -> Int32 { 1 }        // default (generic) algorithm
}
trait RA refines Bidi {}

struct Arr is Deinitializable & Movable { public memberwise init }
given Arr is Bidi {}
given Arr is RA {}

// third party wants: every random-access collection gets a better `lb`
given <T is RA> => T is Bidi { fun lb() -> Int32 { 2 } }

fun run<T is Bidi>(x: T) -> Int32 { x.lb() }
public fun main() -> Int32 { run(Arr()) }
