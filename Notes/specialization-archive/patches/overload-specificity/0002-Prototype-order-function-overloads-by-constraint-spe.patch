@@ -3828,6 +3828,25 @@ public struct Typer {
 
   // MARK: Specificity
 
+  /// Returns `true` iff `lhs` is preferred over `rhs` for overload resolution.
+  ///
+  /// Extends the syntactic preferences of `Program.isPreferred` with an ordering by constraint
+  /// specificity: between two declarations that are otherwise equally good, the one whose context
+  /// clause is entailed by (but does not entail) the other's is preferred.
+  internal mutating func isPreferred(
+    _ lhs: NameResolutionCandidate, other rhs: NameResolutionCandidate,
+    in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    if program.isPreferred(lhs, other: rhs, in: scopeOfUse) { return true }
+    if program.isPreferred(rhs, other: lhs, in: scopeOfUse) { return false }
+
+    guard
+      case .direct(let a) = lhs.reference, case .direct(let b) = rhs.reference, a != b
+    else { return false }
+    return isStrictlyMoreSpecific(a, than: b, in: scopeOfUse)
+  }
+
