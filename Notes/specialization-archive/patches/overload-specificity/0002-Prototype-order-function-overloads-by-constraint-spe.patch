diff --git a/Notes/specialization-experiments/e13.hylo b/Notes/specialization-experiments/e13.hylo
new file mode 100644
index 0000000..ceb6edf
--- /dev/null
+++ b/Notes/specialization-experiments/e13.hylo
@@ -0,0 +1,13 @@
+// G-style concept-based overloading + the generic-context limitation.
+trait Bidi {}
+trait RA refines Bidi {}
+struct Arr is Deinitializable & Movable { public memberwise init }
+given Arr is Bidi {}
+given Arr is RA {}
+
+fun lb<T is Bidi>(x: T) -> Int32 { 1 }   // generic
+fun lb<T is RA>(x: T) -> Int32 { 2 }     // specialized
+
+fun client<T is Bidi>(x: T) -> Int32 { lb(x) }   // sees only Bidi
+
+public fun main() -> Int32 { lb(Arr()) + client(Arr()) }   // want 2 + 2, will get 2 + 1
