index 6e2204e..ab3b5f1 100644
--- a/Notes/specialization-experiments/README.md
+++ b/Notes/specialization-experiments/README.md
@@ -20,3 +20,7 @@ generic client) projects: that is the implementation implicit resolution selecte
 | `e11` | two *incomparable* givens | ambiguous | ambiguous (no silent pick) |
 | `e12` | three-level refinement chain | ambiguous | picks the deepest |
 | `lb`  | realistic `lower_bound`, two models, two levels of generic client code | ambiguous | binary search for the random-access model, linear scan for the other |
+| `e13` | overloads called from a generic client | n/a | client binds the coarse overload (G's documented limit) |
+| `e14` | `Arr<T>`-specific given vs. `RA` vs. `Bidi` givens | ambiguous | the `Arr<T>`-specific one; `Lst<T>` still gets the linear one |
+| `e15` | finer constraint is `where T.Position == Int32` | generic given wins (it is shallower) | **hangs**: continuing the search past the first success reaches the built-in equality givens and explodes |
+| `e16` | same, with only the equality-constrained given (search must fail) | **hangs on `main` too** — pre-existing divergence of a failing search over equality constraints |  |
diff --git a/Notes/specialization-experiments/e14.hylo b/Notes/specialization-experiments/e14.hylo
new file mode 100644
index 0000000..f291481
--- /dev/null
+++ b/Notes/specialization-experiments/e14.hylo
@@ -0,0 +1,18 @@
+// The full chain from the request: Array > RandomAccess > Bidirectional.
+trait Bidi {}
+trait RA refines Bidi {}
+
+struct Arr<T> is Deinitializable & Movable { public memberwise init }
+struct Lst<T> is Deinitializable & Movable { public memberwise init }
+
+given <T> => Arr<T> is Bidi {}
+given <T> => Arr<T> is RA {}
+given <T> => Lst<T> is Bidi {}
+
+trait LowerBound { fun lb() -> Int32 }
+
+given <T is Bidi> => T is LowerBound { fun lb() -> Int32 { 1 } }   // linear
+given <T is RA>   => T is LowerBound { fun lb() -> Int32 { 2 } }   // binary search
+given <U> => Arr<U> is LowerBound   { fun lb() -> Int32 { 3 } }    // hand-tuned for Arr
+
+public fun main() -> Int32 { Arr<Int32>().lb() + Lst<Int32>().lb() }
diff --git a/Notes/specialization-experiments/e15.hylo b/Notes/specialization-experiments/e15.hylo
new file mode 100644
index 0000000..18ab584
--- /dev/null
+++ b/Notes/specialization-experiments/e15.hylo
@@ -0,0 +1,15 @@
+// Specificity where the finer constraint is an associated-type equality.
+trait Coll { type Position }
+struct Cursor is Deinitializable & Movable { public memberwise init }
+
+struct Fast is Deinitializable & Movable { public memberwise init }
+struct Slow is Deinitializable & Movable { public memberwise init }
+
+given Fast is Coll { type Position = Int32 }
+given Slow is Coll { type Position = Cursor }
+
+trait LowerBound { fun lb() -> Int32 }
+given <T is Coll> => T is LowerBound { fun lb() -> Int32 { 1 } }
+given <T is Coll where T.Position == Int32> => T is LowerBound { fun lb() -> Int32 { 2 } }
+
+public fun main() -> Int32 { Fast().lb() + Slow().lb() }
diff --git a/Notes/specialization-experiments/e16.hylo b/Notes/specialization-experiments/e16.hylo
