@@ -0,0 +1,33 @@
+//! stage:typing no-std
+
+// A given guarded by an equality between an associated type and a concrete type.
+//
+// `specialized` would be the more specific of any pair it competes with -- its requirements include
+// theirs and add one. It applies to nothing, though, because Hylo cannot currently derive
+// `T.Position == Idx` from a conformance that defines `type Position = Idx`; the equality has to be
+// assumed. So nothing witnesses `LowerBound<Fast>` and the member selection fails. Add a second,
+// unguarded given and `Fast.Selected` resolves to that one instead.
+//
+// The test is here because this is the shape that used to make implicit resolution run away rather
+// than fail: searching for an equality it cannot prove, resolution reaches the built-in
+// reflexivity, symmetry and transitivity givens, whose derivations multiply with the depth of the
+// search. The compiler hung, and hung on an unmodified compiler too -- the divergence is in how
+// equalities are searched, not in how candidates are ordered. What stops it now is the budget on
+// `takeSummonResults`, and what this test really pins is that the program fails instead of hanging.
+//
+// When deriving that equality is implemented, this test stops being negative.
+
+trait Coll { type Position }
+
+struct Idx {}
+struct Fast {}
+
+given Fast is Coll { type Position = Idx }
+
+struct Specialized {}
+
+trait LowerBound { type Selected }
+
+given specialized: <T is Coll where T.Position == Idx> => T is LowerBound { type Selected = Specialized }
+
+fun check(x: Fast.Selected) {}
-- 
