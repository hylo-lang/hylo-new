diff --git a/Sources/FrontEnd/Typer/Typer.swift b/Sources/FrontEnd/Typer/Typer.swift
index b5c3c0e..f318825 100644
--- a/Sources/FrontEnd/Typer/Typer.swift
+++ b/Sources/FrontEnd/Typer/Typer.swift
@@ -3929,6 +3929,32 @@ public struct Typer {
     return (x, y)
   }
 
+  /// Returns a substitution instantiating `pattern` to `subject`, or `nil` if there is none.
+  ///
+  /// Only `pattern`'s open variables may be assigned, so the match is one-way. When both types are
+  /// term abstractions, their outputs are ignored: an algorithm's overloads are ordered by the
+  /// operands they accept, exactly as in Siek and Lumsdaine's "callable from" relation.
+  private func matchingHeads(
+    _ pattern: AnyTypeIdentity, _ subject: AnyTypeIdentity
+  ) -> SubstitutionTable? {
+    guard
+      let p = program.types[pattern] as? Arrow, let q = program.types[subject] as? Arrow,
+      p.style == q.style, p.inputs.count == q.inputs.count,
+      p.labels.elementsEqual(q.labels)
+    else {
+      return program.types.unifiable(pattern, subject)
+    }
+
+    var s = SubstitutionTable()
+    for (x, y) in zip(p.inputs, q.inputs) {
+      guard
+        x.access == y.access,
+        program.types.unifiable(x.type, y.type, extending: &s, handlingCoercionsWith: { _, _ in false })
+      else { return nil }
+    }
+    return s
+  }
+
   /// Returns `true` iff, in the scope of `a`, the head of `b` can be instantiated to the head of
   /// `a` and every requirement of `b` is derivable.
   ///
@@ -3952,8 +3978,9 @@ public struct Typer {
           .data(using: .utf8)!)
     }
 
-    // The heads must match.
-    guard var s = program.types.unifiable(hb, ha) else {
+    // The heads must match. For term abstractions only the parameters take part: two overloads
+    // of an algorithm are ordered by what they accept, not by what they return.
+    guard var s = matchingHeads(hb, ha) else {
       if dbg { FileHandle.standardError.write("    heads not unifiable\n".data(using: .utf8)!) }
       return false
     }
