+  // MARK: Specificity
+
+  /// Returns `true` iff the given used at the root of `a` is strictly more specific than the one
+  /// used at the root of `b`, in `scopeOfUse`.
+  ///
+  /// A given `g` is *at least as specific* as a given `h` if the head of `h` can be instantiated
+  /// to the head of `g` and, under the assumptions of `g`'s context clause, every requirement of
+  /// that instantiation of `h` is derivable. Intuitively, `g` applies to no more types than `h`
+  /// does, so `g` describes a more refined situation. `g` is *strictly* more specific than `h` if
+  /// it is at least as specific and the converse does not hold.
+  private mutating func isMoreSpecific(
+    _ a: SummonResult, than b: SummonResult, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    guard !isComparingSpecificity else { return false }
+    guard let (x, y) = divergence(a.witness, b.witness) else { return false }
+
+    isComparingSpecificity = true
+    defer { isComparingSpecificity = false }
+
+    return entails(x, y, in: scopeOfUse) && !entails(y, x, in: scopeOfUse)
+  }
+
+  /// Returns the declarations of the givens at the roots of the smallest subterms in which `a` and
+  /// `b` differ, or `nil` if they do not differ in a way that can be compared.
+  ///
+  /// Two derivations of the same type often share a common prefix; the choice that distinguishes
+  /// them is made deeper in the term. This method locates that choice.
+  private func divergence(
+    _ a: WitnessExpression, _ b: WitnessExpression
+  ) -> (DeclarationIdentity, DeclarationIdentity)? {
+    if a.value == b.value { return nil }
+
+    switch (a.value, b.value) {
+    case (.termApplication(let f, let x), .termApplication(let g, let y)):
+      if f.value == g.value { return divergence(x, y) }
+      if x.value == y.value { return divergence(f, g) }
+
+    case (.typeApplication(let f, _), .typeApplication(let g, _)):
+      return divergence(f, g)
+
+    case (.nested(let f), .nested(let g)):
+      return divergence(f, g)
+
+    default:
+      break
+    }
+
+    guard let x = a.declaration, let y = b.declaration, x != y else { return nil }
+    return (x, y)
+  }
+
+  /// Returns `true` iff, in the scope of `a`, the head of `b` can be instantiated to the head of
+  /// `a` and every requirement of `b` is derivable.
+  ///
+  /// The scope of `a` is exactly the context in which `a`'s own requirements hold, so deriving
+  /// `b`'s requirements there amounts to proving that `a`'s assumptions entail `b`'s.
+  private mutating func entails(
+    _ a: DeclarationIdentity, _ b: DeclarationIdentity, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    let k = Memos.DeclarationPair(a, b)
+    if let memoized = cache.scopeToEntailments[scopeOfUse]?[k] { return memoized }
+
+    let result = computeEntailment(a, b, in: scopeOfUse)
+    cache.scopeToEntailments[scopeOfUse, default: [:]][k] = result
+    return result
+  }
+
+  /// Returns `true` iff `a` entails `b`, without consulting or updating the cache.
+  private mutating func computeEntailment(
+    _ a: DeclarationIdentity, _ b: DeclarationIdentity, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    // `a`'s own scope is what exposes its requirements as givens, so `a` must denote one. Givens
+    // introduced by a context parameter or by the compiler have no such scope; they are simply not
+    // ordered against anything.
+    guard program.isScope(a.erased), program.isScope(b.erased) else { return false }
+
+    // `a`'s parameters stay rigid; `b` is opened for unification.
+    let ha = program.types.head(declaredType(of: a))
+    let hypotheses = ScopeIdentity(uncheckedFrom: a.erased)
+    let (ub, hb) = program.types.open(declaredType(of: b))
+
+    // The heads must match.
+    guard var s = program.types.unifiable(hb, ha) else { return false }
+
+    // Every requirement of `b` must hold under `a`'s assumptions.
+    for u in ub {
+      let t = program.types.reify(u, applying: s, withVariables: .kept)
+      guard let r = summon(t, in: hypotheses).first else { return false }
+      s = s.union(r.substitutions)
+    }
+    return true
   }
 
   /// Returns the givens whose definitions are at the top-level of `m`.
