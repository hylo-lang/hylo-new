new file mode 100644
index 0000000..222d6f3
--- /dev/null
+++ b/Tests/CompilerTests/negative/specialization-incomparable-givens.hylo
@@ -0,0 +1,31 @@
+//! stage:typing no-std
+
+// Specificity is a partial order, and where it does not order, nothing is picked.
+//
+// `S` conforms to both `Q` and `R`, so both givens apply. Neither set of requirements entails the
+// other -- `Q` and `R` are unrelated traits -- so neither given applies to fewer types than the
+// other, and both uses below are ambiguous. This is the case a most-specific-wins rule must leave
+// alone: resolving it either way would be an arbitrary choice.
+//
+// The two uses reach the ambiguity by different routes. `check` selects a type member, which is
+// reported as an ambiguous name; `use` needs a witness for the context clause of `client`, which is
+// reported as an ambiguous implicit search whose notes point at the candidates.
+
+trait P { type Selected }
+trait Q {}
+trait R {}
+
+struct S {}
+given S is Q {}
+given S is R {}
+
+struct ViaQ {}
+struct ViaR {}
+
+given via_q: <T is Q> => T is P { type Selected = ViaQ }
+given via_r: <T is R> => T is P { type Selected = ViaR }
+
+fun check(x: S.Selected) {}
+
+fun client<T is P>(x: T) {}
+fun use(s: S) { client(s) }
