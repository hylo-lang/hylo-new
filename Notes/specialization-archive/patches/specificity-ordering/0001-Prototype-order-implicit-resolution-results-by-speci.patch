diff --git a/Sources/FrontEnd/Typer/Typer.swift b/Sources/FrontEnd/Typer/Typer.swift
index 13d9a11..3a93a68 100644
--- a/Sources/FrontEnd/Typer/Typer.swift
+++ b/Sources/FrontEnd/Typer/Typer.swift
@@ -1,3 +1,4 @@
+import Foundation
 import Algorithms
 import OrderedCollections
 import Utilities
@@ -23,6 +24,12 @@ public struct Typer {
   /// The maximum depth of a derivation during implicit search.
   private let maxImplicitDepth = 10
 
+  /// `true` iff the typer is currently comparing the specificity of two givens.
+  ///
+  /// Specificity comparison uses implicit resolution, which must not itself attempt to
+  /// order its results by specificity lest it diverge.
+  private var isComparingSpecificity = false
+
   /// Creates an instance assigning types to syntax trees in `m`, which is a module in `p`.
   public init(
     typing m: Module.ID, of p: consuming Program,
@@ -3541,6 +3548,14 @@ public struct Typer {
     /// Penalties are used to favor lexically closer givens.
     let penalties: Int
 
+    /// The declaration of the given at the root of the derivation being built, if any.
+    ///
+    /// Continuations are applied outside-in, so the first item of the tail (if any) carries the
+    /// elaboration that started this derivation.
+    var root: DeclarationIdentity? {
+      tail.first?.elaboration.witness.declaration ?? witness.declaration
+    }
+
     /// Creates an instance with the given properties.
     init(
       matching witness: WitnessExpression, to queried: AnyTypeIdentity,
@@ -3790,7 +3805,9 @@ public struct Typer {
     var done: [SummonResult] = []
     var depth = 0
 
-    while done.isEmpty && !work.isEmpty && (depth < maxImplicitDepth) {
+    while !work.isEmpty && (depth < maxImplicitDepth)
+      && (done.isEmpty || mayOutrank(work, done, in: scopeOfUse))
+    {
       var next: [ResolutionThread] = []
       for item in work {
         switch match(item, in: scopeOfUse) {
@@ -3802,7 +3819,140 @@ public struct Typer {
       swap(&next, &work)
     }
 
-    return done.minimalElements(by: { (a, b) in a.penalties < b.penalties })
+    if done.count < 2 { return done }
+    let best = done.minimalElements(by: { (a, b) in isMoreSpecific(a, than: b, in: scopeOfUse) })
+    if best.count < 2 { return best }
+    return best.minimalElements(by: { (a, b) in a.penalties < b.penalties })
+  }
+
+
+  // MARK: Specificity
+
+  /// Returns `true` iff some thread in `work` is rooted at a given that is strictly more specific
+  /// than the root of every result in `done`, and is therefore still worth exploring.
+  private mutating func mayOutrank(
+    _ work: [ResolutionThread], _ done: [SummonResult], in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    guard !isComparingSpecificity else { return false }
+    let incumbents = Set(done.compactMap(\.witness.declaration))
+    if incumbents.isEmpty { return false }
+
+    let dbg = ProcessInfo.processInfo.environment["HYLO_DEBUG_SPEC"] != nil
+    var seen = Set<DeclarationIdentity>()
+    for t in work {
+      guard let r = t.root, !incumbents.contains(r), seen.insert(r).inserted else { continue }
