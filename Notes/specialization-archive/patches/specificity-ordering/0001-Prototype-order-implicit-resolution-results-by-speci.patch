+  /// Returns `true` iff the given declared by `a` is strictly more specific than the one declared
+  /// by `b`, in `scopeOfUse`.
+  private mutating func isStrictlyMoreSpecific(
+    _ a: DeclarationIdentity, than b: DeclarationIdentity, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    guard !isComparingSpecificity, a != b else { return false }
+    isComparingSpecificity = true
+    defer { isComparingSpecificity = false }
+    return entails(a, b, in: scopeOfUse) && !entails(b, a, in: scopeOfUse)
+  }
+
+
+  /// Returns `true` iff the given used at the root of `a` is strictly more specific than the one
+  /// used at the root of `b`, in `scopeOfUse`.
+  ///
+  /// A given `g` is *at least as specific* as a given `h` if the head of `h` can be instantiated
+  /// to the head of `g` and, under the assumptions of `g`'s context clause, every requirement of
+  /// that instantiation of `h` is derivable. Intuitively, `g` applies to no more types than `h`
+  /// does, so `g` describes a more refined situation. `g` is *strictly* more specific than `h` if
+  /// it is at least as specific and the converse does not hold.
+  private mutating func isMoreSpecific(
+    _ a: SummonResult, than b: SummonResult, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    guard !isComparingSpecificity else { return false }
+    guard let (x, y) = divergence(a.witness, b.witness) else { return false }
+
+    isComparingSpecificity = true
+    defer { isComparingSpecificity = false }
+
+    return entails(x, y, in: scopeOfUse) && !entails(y, x, in: scopeOfUse)
+  }
+
+  /// Returns the declarations of the givens at the roots of the smallest subterms in which `a` and
+  /// `b` differ, or `nil` if they do not differ in a way that can be compared.
+  ///
+  /// Two derivations of the same type often share a common prefix; the choice that distinguishes
+  /// them is made deeper in the term. This method locates that choice.
+  private func divergence(
+    _ a: WitnessExpression, _ b: WitnessExpression
+  ) -> (DeclarationIdentity, DeclarationIdentity)? {
+    if a.value == b.value { return nil }
+
+    switch (a.value, b.value) {
+    case (.termApplication(let f, let x), .termApplication(let g, let y)):
+      if f.value == g.value { return divergence(x, y) }
+      if x.value == y.value { return divergence(f, g) }
+
+    case (.typeApplication(let f, _), .typeApplication(let g, _)):
+      return divergence(f, g)
+
+    case (.nested(let f), .nested(let g)):
+      return divergence(f, g)
+
+    default:
