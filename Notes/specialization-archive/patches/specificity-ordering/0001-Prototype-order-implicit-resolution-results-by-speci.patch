+    }
+
+    guard let x = a.declaration, let y = b.declaration, x != y else { return nil }
+    return (x, y)
+  }
+
+  /// Returns `true` iff, in the scope of `a`, the head of `b` can be instantiated to the head of
+  /// `a` and every requirement of `b` is derivable.
+  ///
+  /// The scope of `a` is exactly the context in which `a`'s own requirements hold, so deriving
+  /// `b`'s requirements there amounts to proving that `a`'s assumptions entail `b`'s.
+  private mutating func entails(
+    _ a: DeclarationIdentity, _ b: DeclarationIdentity, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    let dbg = ProcessInfo.processInfo.environment["HYLO_DEBUG_SPEC"] != nil
+
+    // `a`'s parameters stay rigid; its own scope exposes its requirements as givens.
+    let ha = program.types.head(declaredType(of: a))
+    let hypotheses = ScopeIdentity(uncheckedFrom: a.erased)
+
+    // `b` is opened for unification.
+    let (ub, hb) = program.types.open(declaredType(of: b))
+
+    if dbg {
+      FileHandle.standardError.write(
+        "  entails? a.head=\(program.show(ha)) | b.head=\(program.show(hb)) b.usings=\(ub.map({ program.show($0) }))\n"
+          .data(using: .utf8)!)
+    }
+
+    // The heads must match.
+    guard var s = program.types.unifiable(hb, ha) else {
+      if dbg { FileHandle.standardError.write("    heads not unifiable\n".data(using: .utf8)!) }
+      return false
+    }
+
+    // Every requirement of `b` must hold under `a`'s assumptions.
+    for u in ub {
+      let t = program.types.reify(u, applying: s, withVariables: .kept)
+      let rs = summon(t, in: hypotheses)
+      guard let r = rs.first else {
+        if dbg {
+          FileHandle.standardError.write("    cannot derive \(program.show(t))\n".data(using: .utf8)!)
+        }
+        return false
+      }
+      s = s.union(r.substitutions)
+    }
+    if dbg { FileHandle.standardError.write("    YES\n".data(using: .utf8)!) }
+    return true
