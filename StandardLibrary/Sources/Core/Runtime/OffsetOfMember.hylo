type Size = UInt32

type Alignment = UInt16

// Because the integer types are incomplete
extension UInt32 {

  /// Creates an instance with the value of `x`.
  @inline(always)
  public init(x: UInt16) {
    &self.value = Builtin.zext_i16_i32(x.value)
  }

  @inline(always)
  public fun infix% (other: Self) -> Self {
    .new(value: Builtin.urem_i32(self.value, other.value))
  }

  @inline(always)
  public static fun zero() -> Self {
    .new(value: Builtin.zeroinitializer_i32())
  }

  /// Creates an instance having the low 32 bits of `x`.
  @inline(always)
  public init(truncating x: Int) {
    &self.value = Builtin.trunc_word_i32(x.value)
  }

}

extension UInt16 {

  /// Returns the first n >= i that is a multiple of self
  @inline(always)
  fun first_aligned_offset(starting_from i: Size) -> Size {
    let a = Size(self)
    // The distance from i to the nearest aligned offset <= i.
    let excess = i % a
    return if excess == (0 as Size) { i.copy() } else { i - excess + a }
  }

  /// Creates an instance having the low 16 bits of `x`.
  @inline(always)
  public init(truncating x: Int) {
    &self.value = Builtin.trunc_word_i16(x.value)
  }

}

public given Pointer<UInt8> is Deinitializable {

  public fun deinit() {}

}

public given Pointer<UInt8> is Movable {}

extension Pointer<UInt8> {

  // Workaround for https://github.com/hylo-lang/hylo-new/issues/357
  // and https://github.com/hylo-lang/hylo-new/issues/365
  /// Initializes `self` to the null pointer.
  public init() {
    &self.value = Builtin.zeroinitializer_ptr()
  }

}

/// The header of the structure representing information stored in all type witnesses.
///
/// See Sources/BackEnd/ModuleGenerationContext.swift for a complete description.
public struct TypeWitnessHeader {
  @inline(always)
  public memberwise init

  // TODO: verify that the type of `description` is correct.
  // see https://github.com/hylo-lang/hylo-new/issues/306
  let description: Pointer<UInt8>
  let size: Size
  let alignment: Alignment
  let type_argument_or_parameter_count: UInt16
}

extension Pointer<TypeWitnessHeader> {

  public type Pointee = TypeWitnessHeader

  @inline(always)
  public fun copy() -> Self {
    .new(value: self.value)
  }

  fun assign(x: sink Self) inout {
    &self.value = x.value
  }

}

extension RecordMemberType {

  /// Returns the size of an instance
  @inline(always)
  fun size() -> Size {
    (self.value as* let Self.Pointee).size.copy()
  }

  /// Returns the alignment of an instance
  @inline(always)
  fun alignment() -> Alignment {
    (self.value as* let Self.Pointee).alignment.copy()
  }

}

// Because the integer types are incomplete
extension UInt {

  /// Creates an instance with the value of `x`.
  @inline(always)
  public init(x: UInt32) {
    &self.value = Builtin.zext_i32_word(x.value)
  }

}

extension Int {

  /// Creates an instance with the value of `x`.
  @inline(always)
  public init(x: UInt32) {
    &self.value = Builtin.zext_i32_word(x.value)
  }

  /// Replaces `sef` with `other`.
  fun assign(other: Self) inout {
    &self.value = other.value
  }

}

/// Notionally, the type of a member of a record type
type RecordMemberType = Pointer<TypeWitnessHeader>

extension Pointer<RecordMemberType> {

  public type Pointee = RecordMemberType

  /// Returns the size of an instance
  @inline(always)
  fun size() -> Size {
    self.pointee().size()
  }

  /// Returns the alignment of an instance
  @inline(always)
  fun alignment() -> Alignment {
    self.pointee().alignment()
  }

  @inline(always)
  fun pointee() -> Pointee {
    (self.value as* let Self.Pointee).copy()
  }

  /// Replaces the pointee with `x`
  @inline(always)
  fun set_pointee(x: sink Self.Pointee) {
    // Hack: can't seem to move x, even when take_value implemented manually.
    &(self.value as* inout Self.Pointee).value = x.value
  }

  @inline(always)
  public fun copy() -> Self {
    .new(value: self.value)
  }

}

extension Metatype<TypeWitnessHeader> {

  type Subject = TypeWitnessHeader

  /// Returns `self`, granting access to details.
  @inline(always)
  static fun type_info() -> RecordMemberType {
    return Pointer<RecordMemberType>(value: Builtin.address(of: Subject)).pointee()
  }

  /// Returns the size in bytes of the `Subject`.
  @inline(always)
  public static fun size() -> Size {
    Self.type_info().size()
  }

  /// Returns the multiple of bytes to which all instances of `Subject` are aligned.
  @inline(always)
  public static fun alignment() -> Alignment {
    Self.type_info().alignment()
  }

  /// Returns the number of bytes between elements in a buffer of `Subject`.
  @inline(always)
  public static fun stride() -> Size {
    Self.alignment().first_aligned_offset(starting_from: Self.size())
  }

}

extension Pointer<TypeWitnessHeader> {

  @inline(always)
  public fun infix+ (offset: Int) -> Self {
    let byte_offset = Int(Metatype<TypeWitnessHeader>.stride()) * offset
    return Self(value: Builtin.advanced_by_bytes_word(self.value, byte_offset.value))
  }

  @inline(always)
  public fun infix+= (offset: Int) inout {
    &self.value = (self + offset).value
  }

}

extension Metatype<RecordMemberType> {

  public type Subject = RecordMemberType

  /// Returns `self`, granting access to details.
  @inline(always)
  static fun type_info() -> RecordMemberType {
    return Pointer<RecordMemberType>(value: Builtin.address(of: Subject)).pointee()
  }

  /// Returns the size in bytes of the `Subject`.
  @inline(always)
  public static fun size() -> Size {
    Self.type_info().size()
  }

  /// Returns the multiple of bytes to which all instances of `Subject` are aligned.
  @inline(always)
  public static fun alignment() -> Alignment {
    Self.type_info().alignment()
  }

  /// Returns the number of bytes between elements in a buffer of `Subject`.
  @inline(always)
  public static fun stride() -> Size {
    Self.alignment().first_aligned_offset(starting_from: Self.size())
  }

}

extension Pointer<RecordMemberType> {

  /// Returns `self` advanced in memory by `offset` `Pointee`s.
  @inline(always)
  public fun infix+ (offset: UInt32) -> Self {
    let byte_offset = UInt(Metatype<Self.Pointee>.stride()) * UInt(offset)
    return Self(value: Builtin.advanced_by_bytes_word(self.value, byte_offset.value))
  }

  /// Returns `self` advanced in memory by `offset` `Pointee`s.
  @inline(always)
  public fun infix+ (offset: Int) -> Self {
    let byte_offset = Int(Metatype<Self.Pointee>.stride()) * offset
    return Self(value: Builtin.advanced_by_bytes_word(self.value, byte_offset.value))
  }

  /// Advances `self` in memory by `offset` `Pointee`s.
  @inline(always)
  public fun infix+= (offset: Int) inout {
    &self.value = (self + offset).value
  }

  /// Returns `self` advanced in memory by `-offset` `Pointee`s.
  @inline(always)
  public fun infix- (offset: Int) -> Self {
    let byte_offset = Int(Metatype<Self.Pointee>.stride()) * (0 - offset)
    return Self(value: Builtin.advanced_by_bytes_word(self.value, byte_offset.value))
  }

  /// Advances `self` in memory by `-offset` `Pointee`s.
  @inline(always)
  public fun infix-= (offset: Int) inout {
    &self.value = (self - offset).value
  }

  /// Returns `true` iff `other` has an equivalent value.
  @inline(always)
  public fun infix== (other: Self) -> Bool {
    Bool(value: Builtin.icmp_eq_ptr(self.value, other.value))
  }

  /// Returns `false` iff `other` has an equivalent value.
  @inline(always)
  public fun infix!= (other: Self) -> Bool {
    !(self == other)
  }

  /// Returns `true` iff `other` follows `self` in memory.
  @inline(always)
  public fun infix< (other: Self) -> Bool {
    Bool(value: Builtin.icmp_ult_ptr(self.value, other.value))
  }

  /// Replaces `sef` with `other`.
  fun assign(other: Self) inout {
    &self.value = other.value
  }

}

extension Metatype<Pointer<UInt8>> {

  type Subject = Pointer<UInt8>

  /// Returns `self`, granting access to details.
  @inline(always)
  static fun type_info() -> Pointer<TypeWitnessHeader> {
    return Pointer<Pointer<TypeWitnessHeader>>(value: Builtin.address(of: Subject)).pointee()
  }

  /// Returns the multiple of bytes to which all instances of `Subject` are aligned.
  @inline(always)
  public static fun alignment() -> Alignment {
    Self.type_info().alignment()
  }

}

extension Metatype<UInt32> {

  type Subject = UInt32

  /// Returns `self`, granting access to details.
  @inline(always)
  static fun type_info() -> Pointer<TypeWitnessHeader> {
    return Pointer<Pointer<TypeWitnessHeader>>(value: Builtin.address(of: Subject)).pointee()
  }

  /// Returns the multiple of bytes to which all instances of `Subject` are aligned.
  @inline(always)
  public static fun alignment() -> Alignment {
    Self.type_info().alignment()
  }

}

extension Metatype<UInt16> {

  type Subject = UInt16

  /// Returns `self`, granting access to details.
  @inline(always)
  static fun type_info() -> Pointer<TypeWitnessHeader> {
    return Pointer<Pointer<TypeWitnessHeader>>(value: Builtin.address(of: Subject)).pointee()
  }

  /// Returns the multiple of bytes to which all instances of `Subject` are aligned.
  @inline(always)
  public static fun alignment() -> Alignment {
    Self.type_info().alignment()
  }

}

/// Removes the contiguous elements at the tail of `start..<end` whose
/// alignment is less than `a`.
fun drop_last(
  from start: Pointer<RecordMemberType>,
  to end: inout Pointer<RecordMemberType>,
  while_alignment_less_than a: Alignment
) {
  while end != start {
    if (end - 1).pointee().alignment() >= a { return }
    end -= 1
  }
}

/// Removes the contiguous elements at the head of `start..<end` whose
/// pointees have alignment less than or equal to `a`.
fun drop_first(
  from start: inout Pointer<RecordMemberType>,
  to end: Pointer<RecordMemberType>,
  while_alignment_no_greater_than a: Alignment
) {
  while start != end {
    if start.pointee().alignment() > a {
      return
    }
    start += 1
  }
}

/// Shifts the contents of `start..<end` one position later in memory.
fun shift_backward1(
  from start: Pointer<RecordMemberType>,
  until end: Pointer<RecordMemberType>
) {
  var e = end.copy()
  while e != start {
    let e0 = e - 1
    e.set_pointee(e0.pointee().copy())
    &e.value = e0.value
  }
}

/// Inserts `source.pointee()` at the latest position *q* in
/// `destinationStart...destinationEnd` such that all its
/// predecessors' `pointee`s have `alignment` ≥
/// *q*`.pointee().alignment()`.
///
/// - Precondition: the pointees of
///   `destinationStart..<destinationEnd` are sorted by decreasing
///   alignment.
/// - Precondition: `source >= destinationEnd`.
fun insert_backward_stably_sorted_by_decreasing_alignment(
  into destinationStart: Pointer<RecordMemberType>,
  until destinationEnd: inout Pointer<RecordMemberType>,
  from source: Pointer<RecordMemberType>
) {
  let r = source.pointee()
  let r_alignment = r.alignment()

  var i = destinationEnd.copy()
  drop_last(
    from: destinationStart, to: &i, while_alignment_less_than: r_alignment)

  // Workaround #370
  insert_backward_stably_sorted_by_decreasing_alignment1(source, i, destinationEnd, r)
  destinationEnd += 1
}

fun insert_backward_stably_sorted_by_decreasing_alignment1(
  source: Pointer<RecordMemberType>, i: Pointer<RecordMemberType>,
  destinationEnd: Pointer<RecordMemberType>, r: RecordMemberType)
{
  if source != i {
    shift_backward1(from: i, until: destinationEnd)
    i.set_pointee(r.copy())
  }
}

/// Inserts each pointee in `sourceStart_..<sourceEnd` whose
/// `alignment()` is greater than `a` into
/// `destinationStart...destinationEnd` such that all their
/// predecessors' `pointee`s have `alignment` ≥
/// *q*`.pointee().alignment()`.
///
/// - Precondition: the pointees of
///   `destinationStart..<destinationEnd` are sorted by decreasing
///   alignment.
/// - Precondition: `sourceStart_ >= destinationEnd`.
fun insert_backward_stably_sorted_by_decreasing_alignment(
  into destinationStart: Pointer<RecordMemberType>,
  until destinationEnd: inout Pointer<RecordMemberType>,
  from sourceStart: sink Pointer<RecordMemberType>,
  until sourceEnd: Pointer<RecordMemberType>,
  where_alignment_exceeds a: Alignment
) {
  while sourceStart != sourceEnd {
    if sourceStart.pointee().alignment() > a {
      insert_backward_stably_sorted_by_decreasing_alignment(
        into: destinationStart, until: &destinationEnd, from: sourceStart)
    }
    sourceStart += 1
  }
}

/// Removes from start..<end the elements with alignments less than
/// that of n, or with the same alignment as n but occurring at a
/// position > n, and stably sorts them by decreasing alignment.
fun filter_and_stable_sort_elements_by_decreasing_alignment(
  from start: inout Pointer<RecordMemberType>,
  to end: inout Pointer<RecordMemberType>,
  that_lay_out_before n: Pointer<RecordMemberType>,
  having_alignment n_alignment: Alignment
) {
  // Drop initial unretained elements before n
  drop_first(from: &start, to: n, while_alignment_no_greater_than: n_alignment - (1 as Alignment))

  var new_end: Pointer<RecordMemberType>
  sink let tail_start: Pointer<RecordMemberType>

  if start != n {
    // insert elements up to n
    &new_end = start + 1

    insert_backward_stably_sorted_by_decreasing_alignment(
      into: start, until: &new_end, from: start + 1, until: n,
      where_alignment_exceeds: n_alignment - (1 as Alignment))

    &tail_start.value = (n + 1).value
  }
  else {
    // Drop unretained elments after n
    &start = n + 1
    drop_first(from: &start, to: end, while_alignment_no_greater_than: n_alignment)

    if start == end {
      return
    }

    &new_end.value = (start + 1).value
    &tail_start.value = new_end.value
  }

  // insert elements after n
  insert_backward_stably_sorted_by_decreasing_alignment(
    into: start, until: &new_end, from: tail_start, until: end,
    where_alignment_exceeds: n_alignment)
  &end.value = new_end.value
}

/// Returns the size a record type would have were its members given
/// in storage order by `start..<end`.
fun size_of_record_having_ordered_members(
  from start_: Pointer<RecordMemberType>,
  to end: Pointer<RecordMemberType>
) -> Size {
  var r: Size = 0
  var start = start_.copy()
  while start < end {
    let w = start.pointee()
    let position = w.alignment().first_aligned_offset(starting_from: r)
    &r = position + w.size()
    &start += 1
  }
  return r
}

/// Returns the offset of the `n`th member in declaration order of a
/// record type having members given by the array of length `l` at
/// `memberArray`.
///
/// Mutates the elements in the array in arbitrary ways.
fun __hylo_offset_of_member(
  n: UInt32,
  in memberArray: Pointer<RecordMemberType>, of_length l: UInt32) -> UInt32
{
  sink let p = memberArray + Int(n)
  sink let nth_alignment = p.pointee().alignment()
  var start = memberArray.copy()
  var end = memberArray + Int(l)

  filter_and_stable_sort_elements_by_decreasing_alignment(from: &start, to: &end, that_lay_out_before: p, having_alignment: nth_alignment)
  if start == end { return 0 }
  let preceding_size = size_of_record_having_ordered_members(from: start, to: end)
  sink let r = nth_alignment.first_aligned_offset(starting_from: preceding_size)
  return r
}
