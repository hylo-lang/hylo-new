extension <T> Metatype<T> {

  /// Returns the size of the type `T` in bytes.
  @inline(always)
  public static fun size() -> UInt32 {
    Pointer<RecordMemberType>(value: Builtin.address(of: T)).pointee().size()
  }

  /// Returns the alignment of the type `T` in bytes.
  @inline(always)
  public static fun alignment() -> UInt16 {
    Pointer<RecordMemberType>(value: Builtin.address(of: T)).pointee().alignment()
  }

  /// Returns the stride of the type `T` in bytes.
  @inline(always)
  public static fun stride() -> UInt32 {
    Self.size().rounded_up(to_nearest_multiple_of: Self.alignment())
  }

}
