/// A type whose instances can be copied.
@_symbol("Copyable")
public trait Copyable refines Movable {

  /// Returns a copy of `self`.
  @_symbol("Copyable.copy(:)")
  fun copy() -> Self

}

/// A witness that `Void` is `Copyable`.
public given Void is Copyable {}

