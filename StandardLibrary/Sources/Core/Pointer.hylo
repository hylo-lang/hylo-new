/// A typed memory address whose contents can be read.
public struct Pointer<Pointee> is Deinitializable {

  /// The underlying builtin value.
  module var value: Builtin.ptr

  /// Creates an instance from its underlying builtin value.
  memberwise init

  /// The value pointed to by `self`.
  ///
  /// - Requires: `self` points to a complete object of type `Pointee`.
  @inline(always)
  public subscript unsafe() auto -> Pointee {
    /// - Requires: the pointee is not mutated during this projection's lifetime.
    let { yield (self.value as* (let Pointee)) }

    /// - Requires: while this projection is active, no other projection that includes the pointee
    ///   is active.
    inout { yield &(self.value as* (inout Pointee)) }
  }

  /// Creates an instance referring to the same address as `p`.
  ///
  /// - Note: when accessing the pointee of the result, make sure its lifetime is upheld.
  @inline(always)
  public init<Other>(type_punning p: Pointer<Other>) {
    &self.value = p.value
  }

  /// Returns `self` offset by `n` elements, treating memory as an array of `Pointee`.
  ///
  /// - Note: when accessing the pointee of the result, make sure its lifetime is upheld.
  @inline(always)
  public fun advanced(by n: Int) -> Self {
    let offset_in_bytes = Metatype<Pointee>.stride() * n
    return .new(value: Builtin.advanced_by_bytes_word(self.value, offset_in_bytes.value))
  }

  /// Creates an instance that does not address any usable storage.
  @inline(always)
  public static fun null() -> Self {
    .new()
  }

  /// Creates an instance that does not address any usable storage, equal to `.null()`.
  @inline(always)
  public init() {
    &self.value = Builtin.zeroinitializer_ptr()
  }

  // MARK: Conformance to Copyable.

  /// Returns an equivalent instance.
  ///
  /// - Note: when accessing the pointee of the result, make sure its lifetime is upheld.
  @inline(always)
  public fun copy() -> Self {
    Pointer(value: self.value)
  }

  // MARK: Conformance to Equatable.

  /// Returns `true` iff `other` has an equivalent value.
  @inline(always)
  public fun infix== (other: Self) -> Bool {
    Bool(value: Builtin.icmp_eq_ptr(self.value, other.value))
  }

  /// Returns `true` iff `self is not equal to `other`.
  @inline(always)
  public fun infix!= (other: Self) -> Bool {
    Bool(value: Builtin.icmp_ne_ptr(self.value, other.value))
  }

}

public given <T> => Pointer<T> is Movable {}

public given <T> => Pointer<T> is Copyable {}

public given <T> => Pointer<T> is Equatable {}

extension <Pointee is Movable> Pointer<Pointee> {

  /// Returns the value pointed to by `self`, leaving the storage uninitialized.
  ///
  /// - Requires: `self` points to a complete object of type `Pointee`.
  @inline(always)
  public fun unsafe_move_pointee() -> Pointee {
    self.value as* (sink Pointee)
  }

  /// Initializes the storage pointed to by `self` to `value`.
  ///
  /// - Requires: the `Metatype<Pointee>.size()` bytes starting at the address are uninitialized
  ///   and suitably aligned for `Pointee`.
  @inline(always)
  public fun unsafe_initialize_pointee(value: sink Pointee) {
    &(self.value as* (set Pointee)) = value
  }

}

extension <Pointee is Deinitializable> Pointer<Pointee> {

  /// Deinitializes the value pointed to by `self`.
  @inline(always)
  public fun unsafe_deinitialize_pointee() {
    (self.value as* (sink Pointee)).deinit()
  }

}
